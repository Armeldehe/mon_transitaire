# ==============================================================================
# VARIABLES D'ENVIRONNEMENT — MON TRANSITAIRE
# ==============================================================================
# Ces variables sont requises pour le bon fonctionnement de l'application.
# À configurer dans Vercel lors du déploiement.

# 1. Supabase (Authentification & Stockage)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 2. Base de données (Prisma)
# Utiliser l'URL de connexion "Transaction pooling" (Port 6543) pour Vercel
DATABASE_URL=your_database_connection_string

# Note: Ne commitez jamais vos vraies clés dans GitHub !
